OPENAI_API_KEY=your-openai-key-here
EDGAR_IDENTITY=Your Name your-email@email.com

# Optional. Local runs keep the defaults; the hosted service sets these.
# LOG_FORMAT=console            # or json: one JSON object per line
# RATE_LIMIT_PER_MINUTE=10      # per client IP, /query only; leave out = off
# DAILY_QUERY_BUDGET=50         # all clients, per UTC day; leave out = off
